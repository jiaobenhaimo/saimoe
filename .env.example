# ── 数据库连接:二选一 ─────────────────────────────────────────
# 【推荐】分开填 —— 密码含 @ : / ? # % 等特殊字符也无需任何编码:
MYSQL_HOST="10.x.x.x"              # CloudBase MySQL「直连服务」地址(优先用内网地址)
MYSQL_PORT="3306"
MYSQL_USER="your-db-username"
MYSQL_PASSWORD="your-db-password"  # 原样粘贴,不要编码
MYSQL_DATABASE="sml-xxxxxxxx"

# 或者:单条连接串(若密码含特殊字符,必须做百分号编码):
# DATABASE_URL="mysql://user:pass@host:3306/dbname"

# ── 管理令牌:进入 /admin 和推进赛程用,设一段长随机串 ──────────
ADMIN_TOKEN="change-me-to-a-long-random-string"

# ── 可选:调 Bangumi API 的 User-Agent ────────────────────────
BGM_USER_AGENT="bgm-saimoe/1.0"

# 说明:用 docker-compose.yml 自托管时,上面的 MYSQL_PASSWORD 会同时用于
# 初始化内置 MySQL 容器,应用则通过 compose 自动拼好的 DATABASE_URL 连接,
# 你无需手填 MYSQL_HOST 等其余变量。
