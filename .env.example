# ── 数据存储:本地 JSON 文件,无需外部数据库 ────────────────────
# 数据文件目录。留空则默认容器内 ./.data(临时!重新部署会清空)。
# 想让数据在重新部署后保留,请把它指到一个持久化挂载目录(如云硬盘/NAS)。
DATA_DIR="/data"

# ── 服务 API 总开关(默认关闭)────────────────────────────────
# 关闭时,除 /api/health 外的所有接口都返回 503;要正式服务必须设为 "true"。
API_ENABLED="true"

# ── 管理令牌:进入 /admin 和推进赛程用,设一段长随机串 ──────────
ADMIN_TOKEN="change-me-to-a-long-random-string"

# ── 可选:调 Bangumi API 的 User-Agent ────────────────────────
BGM_USER_AGENT="jiaobenhaimo/saimoe (https://github.com/jiaobenhaimo/saimoe)"

# ── 可选:DNS 污染规避(云托管常见)────────────────────────────
# 部分云托管(如 CloudBase Run)容器系统 DNS 会把 api.bgm.tv 解析成被墙 IP,
# 导致连接超时。应用默认通过 DoH(阿里 dns.alidns.com / DNSPod doh.pub)解析,
# 过滤被污染的答案,内置一组已知可用 IP,并在多个候选 IP 间做故障转移(reset 就换下一个)。
# 打开 /api/diag 可逐个 IP 查看连通情况(status=401 即为通)。
# 若仍全部失败,二选一:
# BGM_API_IP="199.193.116.105"   # 固定 api.bgm.tv 到某个已知可用 IP
# BGM_IMG_IP=""                  # 固定 bgm.tv 图片域名到该 IP(可选)
# BGM_PROXY="http://host:port"   # 或走正向代理(用于按 SNI 封锁、所有直连 IP 都不通时)

# ── 数据备份(每 30 分钟自动快照)─────────────────────────────
# 快照写入目录。默认 /mnt/sml-data(本地挂载盘),建议指向持久化挂载点。
BACKUP_DIR="/mnt/sml-data"
# 本地保留的快照份数(48 份 ≈ 最近 24 小时)。
BACKUP_KEEP="48"

# ── 调试模式(仅测试用,上线务必删除或设为 false)──────────────
# 开启后 /admin 会出现「调试模式」面板,可一键造测试数据、灌票、模拟整届赛程。
# 需要同时设置 ADMIN_TOKEN。
# DEBUG_MODE="true"
