# ── 数据存储：本地 JSON 文件，无需外部数据库 ────────────────────
# 数据文件目录。留空则默认容器内 ./.data（临时！重新部署会清空）。
# 想让数据在重新部署后保留，请把它指到一个持久化挂载目录（如云硬盘/NAS）。
DATA_DIR="/data"

# ── 服务 API 总开关（默认关闭）────────────────────────────────
# 关闭时，除 /api/health 外的所有接口都返回 503；要正式服务必须设为 "true"。
API_ENABLED="true"

# ── 管理令牌：进入 /admin 和推进赛程用，设一段长随机串 ──────────
ADMIN_TOKEN="change-me-to-a-long-random-string"

# ── 提名清理：未投票的自提名角色多久后清除（分钟）──────────────
# 用户把角色加进提名池但一直没人投提名票时，超过这个时长会被自动清理，
# 避免池子堆满没人支持的空角色。留空默认 30 分钟。用户主动关闭页面时会
# 立即清理自己的 0 票自提名（前端 beacon），此项是防漏的服务端兜底。
# SAIMOE_ORPHAN_GRACE_MIN="30"

# ── 异常投票看板阈值（可选；/admin 看板用）──────────────────────
# 投票会记录时间戳、粗粒度设备指纹（device_bucket）和客户端 IP，仅用于 /admin
# 的异常检测与人工作废，不用于自动拦截/去重。下列阈值留空则用默认值。
# SAIMOE_OBS_DEVICE_MIN="3"        # 同一设备指纹关联多少个身份即标记
# SAIMOE_OBS_IP_MIN="4"            # 同一 IP 关联多少个身份即标记（NAT 下建议更高）
# SAIMOE_OBS_BURST_WINDOW_MS="10000"
# SAIMOE_OBS_BURST_MIN="8"         # 上述窗口内单身份投票数达到即标记
# SAIMOE_OBS_COVERAGE_PCT="0.9"    # 单身份投了 ≥ 该比例的全部对局即标记

# ── 数据备份（每 30 分钟自动快照）─────────────────────────────
# 快照写入目录。默认 /mnt/sml-data（本地挂载盘），建议指向持久化挂载点。
BACKUP_DIR="/mnt/sml-data"
# 本地保留的快照份数（48 份 ≈ 最近 24 小时）。
BACKUP_KEEP="48"

# ── 调试模式（仅测试用，上线务必删除或设为 false）──────────────
# 开启后 /admin 会出现「调试模式」面板，可一键造测试数据、灌票、模拟整届赛程。
# 需要同时设置 ADMIN_TOKEN。
# DEBUG_MODE="true"

# ── 公众号「拉取式投票链接 + 投票门禁」（可选，默认关闭） ─────────────
# 开启后：只有从公众号「回复投票」拿到专属链接的用户能投票，直连网站只读。
# WX_VOTE_GATE="on"                     # 仅作「初始默认」；门禁现在可在 admin 页随时开关（会覆盖此项）。不设=默认关闭（无需微信，人人可投）
# WX_TOKEN="与公众号后台服务器配置里的 Token 一致"   # 用于校验微信回调签名（/api/wx）
# SESSION_SECRET="一段足够长的随机字符串"            # 签发投票链接/会话 token 的密钥（不设则回退用 ADMIN_TOKEN）
                                                  # 注意：NODE_ENV=production 且两者都没设时会直接报错，
                                                  # 不再用仓库里那个固定的开发密钥签名（否则任何人都能伪造会话）
# PUBLIC_BASE_URL="https://你的域名"                 # 生成投票链接用的站点根地址
VOTER_ID_MODE=  # 留空=按设备指纹去重（默认）;sid=按服务端签名 cookie 去重（更防刷，仅在开赛前切换）

# ── 站点专属信息（联系方式 / 主办 / 鸣谢 / 二维码）─────────────────────
# 这些内容不放仓库，改放服务器上的未跟踪文件：
#   $DATA_DIR/site.json      内容见仓库里的 site.example.json
#   $DATA_DIR/site/*.png     二维码图片，由 /api/site/<文件名> 提供
# 想换目录再设这个（默认 $DATA_DIR/site）：
SITE_DIR=


# ── 真实客户端 IP（关系到限流与「同设备多身份」检测的准确性）────────────────────
# x-forwarded-for 的第一段是**客户端可以自己伪造**的：请求带上 X-Forwarded-For: 1.2.3.4 时，
# 反代是往后追加而不是覆盖。IP 既用于限流、也参与 device_bucket 的哈希，所以伪造它等于
# 既能无限重置限流、又能让同一台设备看起来来自无数个网络。
#
# 首选：让反代写一个「单值、且总是覆盖」的头，这里填它的名字。
#   Fly.io      → Fly-Client-IP
#   Cloudflare  → CF-Connecting-IP
#   自建 nginx  → 用 proxy_set_header 覆盖 X-Real-IP，然后填 X-Real-IP
# PROXY_IP_HEADER="Fly-Client-IP"
#
# 备选：没有单值头时，从 x-forwarded-for **末尾**倒数第 n 段取（即自己反代追加的那一段）。
# TRUSTED_PROXY_HOPS="1"
#
# ⚠️ 这两个变量只在**两届比赛之间**改。device_bucket = sha256(客户端硬件哈希 | IP)，
#    改了 IP 的取法，新票的标识就和库里已有的对不上，赛中改会让异常检测瞬间失去历史对照。
#    默认（都不设）= 取 x-forwarded-for 第一段，与升级前行为完全一致。

# ── 服务端 Bangumi 网关 / 头像缓存 ──────────────────────────────────────────
# 服务端同时向 Bangumi 发起的请求数上限。搜索/整部作品导入都在服务端完成，
# 这个值防止几十个人同时导入把上游打挂。
# BGM_MAX_INFLIGHT="6"
#
# 头像磁盘缓存。默认 $DATA_DIR/imgcache；指到持久卷可跨重启保留（图床对每张图只被请求一次）。
# IMG_CACHE_DIR="/data/imgcache"
# IMG_CACHE_MB="512"       # 缓存上限，超出按最久未用淘汰
# IMG_MAX_KB="4096"        # 单张图上限，超过直接拒绝（防止上游返回巨大文件把内存吃掉）
