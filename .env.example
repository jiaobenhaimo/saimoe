# MySQL connection string. Works with ANY MySQL-compatible server:
# - 阿里云 RDS MySQL / 腾讯云数据库 MySQL: 用它们控制台给的连接串
# - 腾讯云开发 CloudBase MySQL: 见 DEPLOY_TCB.md
# - 自托管 Docker (see docker-compose.yml): mysql://saimoe:xxx@db:3306/saimoe
DATABASE_URL="mysql://user:pass@host:3306/dbname"

# Any secret string. Needed to open /admin and run competition actions.
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Sent to the Bangumi API as User-Agent (they ask for one). Optional.
BGM_USER_AGENT="bgm-saimoe/1.0"

# Only used by docker-compose.yml to set the self-hosted MySQL root/app password.
MYSQL_PASSWORD="change-me-too"
